<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- AOT/Trimming 配置 -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerDefaultBehaviour>Links</TrimmerDefaultBehaviour>
    <TrimmerWarnOnUnresolvedWarnings>false</TrimmerWarnOnUnresolvedWarnings>
  </PropertyGroup>

<ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- 单元测试需要访问 MountService 的参数构建逻辑 -->
    <InternalsVisibleTo Include="RcloneHelper.Tests" />
  </ItemGroup>
</Project>
