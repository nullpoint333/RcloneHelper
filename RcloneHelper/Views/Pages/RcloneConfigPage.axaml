<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RcloneHelper.Core.Pages"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="620"
             x:Class="RcloneHelper.Views.Pages.RcloneConfigPage"
             x:DataType="vm:RcloneConfigPageViewModel">
    <Grid RowDefinitions="*,Auto">
        <!-- 内容 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,20,20,16" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">

                <!-- 依赖状态 -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="系统依赖" Classes="cardTitle" />
                            <Button Grid.Column="1" Classes="ghost" FontSize="12" Content="重新检测"
                                    Command="{Binding RefreshDependenciesCommand}" />
                        </Grid>

                        <!-- WinFsp -->
                        <Grid ColumnDefinitions="44,*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding FuseDependency.Icon}" FontSize="24"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding FuseDependency.Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" />
                                    <Border Classes="badge">
                                        <TextBlock Classes="badgeText" Text="{Binding FuseDependency.StatusText}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding FuseDependency.Description}" Classes="hint" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="primary" Content="安装"
                                    IsVisible="{Binding FuseDependency.NeedsInstallation}"
                                    Command="{Binding InstallDependencyCommand}"
                                    CommandParameter="{Binding FuseDependency}" />
                        </Grid>

                        <Border Classes="divider" />

                        <!-- rclone -->
                        <Grid ColumnDefinitions="44,*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding RcloneDependency.Icon}" FontSize="24"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding RcloneDependency.Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" />
                                    <Border Classes="badge">
                                        <TextBlock Classes="badgeText" Text="{Binding RcloneDependency.StatusText}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding RcloneDependency.Description}" Classes="hint" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="primary" Content="安装"
                                    IsVisible="{Binding RcloneDependency.NeedsInstallation}"
                                    Command="{Binding InstallDependencyCommand}"
                                    CommandParameter="{Binding RcloneDependency}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 运行信息 -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="运行信息" Classes="cardTitle" />
                            <Button Grid.Column="1" Classes="ghost" FontSize="12" Content="检查更新"
                                    Command="{Binding CheckUpdateCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="版本" Classes="fieldLabel" />
                            <TextBlock Grid.Column="1" Text="{Binding RcloneVersion}" Classes="valueText"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="可执行文件" Classes="fieldLabel" />
                            <TextBlock Grid.Column="1" Text="{Binding RclonePath}" Classes="mono" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="配置文件" Classes="fieldLabel" />
                            <TextBlock Grid.Column="1" Text="{Binding ConfigFilePath}" Classes="mono" />
                        </Grid>
                        <Grid ColumnDefinitions="120,*,Auto">
                            <TextBlock Grid.Column="0" Text="缓存目录" Classes="fieldLabel" />
                            <TextBlock Grid.Column="1" Text="{Binding CacheDir}" Classes="mono" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="ghost" FontSize="12" Content="打开"
                                    Command="{Binding OpenCacheFolderCommand}" />
                        </Grid>
                        <TextBlock Text="缓存位置与上限在「设置 → rclone 缓存」中调整，修改后重新挂载生效。"
                                   Classes="hint" Margin="120,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Remote 列表 -->
                <Border Classes="card" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Border Grid.Row="0" Padding="22,12"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,110,110,80">
                                <TextBlock Grid.Column="0" Text="Remote" Classes="cardTitle" />
                                <TextBlock Grid.Column="1" Text="类型" Classes="hint" />
                                <TextBlock Grid.Column="2" Text="挂载点" Classes="hint" />
                                <TextBlock Grid.Column="3" Text="状态" Classes="hint" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1" Classes="mountList" Margin="6"
                                 ItemsSource="{Binding Remotes}" SelectedItem="{Binding SelectedRemote}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RemoteConfig">
                                    <Grid ColumnDefinitions="*,110,110,80" Margin="10,8">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Classes="badge" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding TypeLabel}" Classes="badgeText" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding LocalDrive}" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="已挂载" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsMounted}" />
                                        <TextBlock Grid.Column="3" Text="未挂载" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsMounted}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2" Margin="16,4,16,14"
                                   Text="列表来自 rclone.conf。选中一项后可卸载或删除；删除应用管理的连接时也会同时移除本地配置。"
                                   Classes="hint" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Command="{Binding RefreshConfigCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource AccentForegroundBrush}"
                                  Data="{DynamicResource IconRefresh}" />
                            <TextBlock Text="刷新" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" Content="打开配置文件夹"
                            Command="{Binding OpenConfigFolderCommand}" />
                    <Button Classes="ghost" Content="打开缓存文件夹"
                            Command="{Binding OpenCacheFolderCommand}" />
                    <Button Classes="secondary" Content="卸载选中"
                            Command="{Binding UnmountSelectedCommand}"
                            IsEnabled="{Binding SelectedRemote.IsMounted, FallbackValue=False}" />
                    <Button Classes="danger" Content="删除选中"
                            Command="{Binding DeleteRemoteCommand}"
                            IsEnabled="{Binding SelectedRemote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>