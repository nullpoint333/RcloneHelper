<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RcloneHelper.Core.Pages"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="620"
             x:Class="RcloneHelper.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,20,20,28" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">

                <!-- ================= 常规 ================= -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="通用" Classes="cardTitle" />
                        <CheckBox Content="开机启动" IsChecked="{Binding AutoStartEnabled}"
                                  Foreground="{DynamicResource ForegroundBrush}" />
                        <StackPanel Spacing="4">
                            <CheckBox Content="静默启动（最小化到托盘）" IsChecked="{Binding StartSilently}"
                                      IsEnabled="{Binding AutoStartEnabled}"
                                      Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="仅在开机自启时生效。" Classes="hint" Margin="28,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= 代理 ================= -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="网络代理" Classes="cardTitle" />
                        <CheckBox Content="启用代理" IsChecked="{Binding ProxyEnabled}"
                                  Foreground="{DynamicResource ForegroundBrush}" />
                        <TextBlock Text="启用后，所有 rclone 操作与连接测试都会经过该代理。"
                                   Classes="hint" Margin="28,0,0,0"
                                   IsVisible="{Binding ProxyEnabled}" />

                        <StackPanel Spacing="10" IsVisible="{Binding ProxyEnabled}">
                            <Grid ColumnDefinitions="120,*">
                                <TextBlock Grid.Column="0" Text="代理服务器" Classes="fieldLabel" />
                                <Grid Grid.Column="1" ColumnDefinitions="100,*,Auto,84">
                                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding ProxyProtocolOptions}"
                                              SelectedItem="{Binding ProxyProtocol}" />
                                    <TextBox Grid.Column="1" Text="{Binding ProxyHost}"
                                             PlaceholderText="127.0.0.1" Margin="6,0,0,0" />
                                    <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="4,0"
                                               Foreground="{DynamicResource ForegroundMutedBrush}" />
                                    <TextBox Grid.Column="3" Text="{Binding ProxyPort}"
                                             PlaceholderText="7890" Margin="4,0,0,0" />
                                </Grid>
                            </Grid>

                            <Grid ColumnDefinitions="120,*">
                                <TextBlock Grid.Column="0" Text="认证（可选）" Classes="fieldLabel" />
                                <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                    <TextBox Grid.Column="0" Text="{Binding ProxyUser}"
                                             PlaceholderText="用户名" />
                                    <TextBox Grid.Column="1" Text="{Binding ProxyPassword}"
                                             PasswordChar="*" PlaceholderText="密码" Margin="6,0,0,0" />
                                </Grid>
                            </Grid>

                            <TextBlock Text="常用端口：HTTP 80/8080，HTTPS 443，SOCKS5 1080/7890。保存后需重新挂载才能生效。"
                                       Classes="hint" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary" Content="保存代理设置"
                                        Command="{Binding SaveProxyCommand}" />
                                <Button Classes="secondary" Content="测试连接"
                                        Command="{Binding TestProxyConnectionCommand}"
                                        IsEnabled="{Binding !IsTestingProxy}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= rclone 缓存 ================= -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="rclone 缓存" Classes="cardTitle" />
                                <TextBlock Text="挂载时的 VFS 缓存目录。缓存较大时建议放到非系统盘。"
                                           Classes="hint" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CacheSizeText}" Classes="hint"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="缓存目录" Classes="fieldLabel" />
                            <TextBox Grid.Column="1" Text="{Binding CacheDir}"
                                     PlaceholderText="留空 = 使用默认位置" />
                            <Button Grid.Column="2" Classes="secondary" Content="浏览" Margin="8,0,0,0"
                                    Command="{Binding BrowseCacheDirCommand}" />
                            <Button Grid.Column="3" Classes="primary" Content="保存" Margin="8,0,0,0"
                                    Command="{Binding SaveCacheSettingsCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Grid.Column="0" Text="缓存上限" Classes="fieldLabel" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <TextBox Text="{Binding VfsCacheMaxSize}" Width="180"
                                         PlaceholderText="留空 = 不限制，例如 10G" />
                                <TextBlock Text="支持 500M / 10G / off 等写法"
                                           Classes="hint" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Classes="divider" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="ghost" Command="{Binding OpenCacheFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Width="13" Height="13" Stretch="Uniform"
                                          Fill="{DynamicResource ForegroundSecondaryBrush}"
                                          Data="{DynamicResource IconFolder}" />
                                    <TextBlock Text="打开文件夹" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost" Command="{Binding RefreshCacheSizeCommand}"
                                    IsEnabled="{Binding !IsCacheBusy}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Width="13" Height="13" Stretch="Uniform"
                                          Fill="{DynamicResource ForegroundSecondaryBrush}"
                                          Data="{DynamicResource IconRefresh}" />
                                    <TextBlock Text="重新统计" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost" Content="清理缓存" FontSize="12"
                                    Command="{Binding ClearCacheCommand}"
                                    IsEnabled="{Binding !IsCacheBusy}" />
                            <Button Classes="ghost" Content="恢复默认" FontSize="12"
                                    Command="{Binding ResetCacheSettingsCommand}" />
                        </StackPanel>

                        <TextBlock Text="{Binding EffectiveCacheDir, StringFormat='当前生效路径：{0}'}"
                                   Classes="hint" TextWrapping="Wrap" />
                        <TextBlock Text="缓存目录与上限修改后，需要卸载并重新挂载才会生效。清理缓存不会影响远端文件。"
                                   Classes="hint" />
                    </StackPanel>
                </Border>

                <!-- ================= 数据 ================= -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="数据与备份" Classes="cardTitle" />

                        <Grid ColumnDefinitions="120,*,Auto">
                            <TextBlock Grid.Column="0" Text="程序数据" Classes="fieldLabel" />
                            <TextBlock Grid.Column="1" Text="{Binding AppDataPath}" Classes="valueText" />
                            <Button Grid.Column="2" Classes="secondary" Content="打开" Padding="12,5"
                                    Command="{Binding OpenAppDataFolderCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,Auto">
                            <TextBlock Grid.Column="0" Text="程序位置" Classes="fieldLabel" />
                            <TextBlock Grid.Column="1" Text="{Binding AppLocation}" Classes="valueText" />
                            <Button Grid.Column="2" Classes="secondary" Content="打开" Padding="12,5"
                                    Command="{Binding OpenAppLocationFolderCommand}" />
                        </Grid>

                        <Border Classes="divider" />

                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary" Content="导出配置" Command="{Binding ExportConfigCommand}" />
                                <Button Classes="secondary" Content="导入配置" Command="{Binding ImportConfigCommand}" />
                            </StackPanel>
                            <TextBlock Text="导出会把所有挂载配置保存为 JSON；导入会读取配置目录中最新的备份，并跳过同名挂载。"
                                       Classes="hint" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= 关于 ================= -->
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="关于" Classes="cardTitle" />
                        <TextBlock Text="{Binding AppVersionLabel}" Classes="valueText" Margin="0,4,0,0" />
                        <TextBlock Text="基于 Avalonia UI 的 rclone 挂载管理工具，支持 WebDAV / FTP / SFTP / S3。"
                                   Classes="hint" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>