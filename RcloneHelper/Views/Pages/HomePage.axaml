<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RcloneHelper.Core.Pages"
             xmlns:models="using:RcloneHelper.Models"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="620"
             x:Class="RcloneHelper.Views.Pages.HomePage"
             x:DataType="vm:HomePageViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ===================== 操作栏 ===================== -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="挂载管理" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SummaryText}" Classes="hint"
                                   VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </StackPanel>
                    <TextBlock Text="{Binding UploadSummaryText}" FontSize="11"
                               Foreground="{DynamicResource WarningBrush}"
                               IsVisible="{Binding HasAnyPendingUploads}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="ghost" Command="{Binding RefreshStatusCommand}" ToolTip.Tip="重新扫描挂载状态">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource ForegroundSecondaryBrush}"
                                  Data="{DynamicResource IconRefresh}" />
                            <TextBlock Text="刷新" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Classes="secondary" Content="全部挂载" Command="{Binding MountAllCommand}" />
                    <Button Classes="secondary" Content="全部卸载" Command="{Binding UnmountAllCommand}" />
                    <Button Classes="primary" Command="{Binding AddMountCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{DynamicResource AccentForegroundBrush}"
                                  Data="{DynamicResource IconAdd}" />
                            <TextBlock Text="添加挂载" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 搜索与筛选 ===================== -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="20,12,20,10">
            <TextBox Grid.Column="0" Width="300" HorizontalAlignment="Left"
                     Text="{Binding SearchText}"
                     PlaceholderText="搜索名称、类型、地址或挂载点" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="chip" Classes.active="{Binding FilterAll}"
                        Content="全部" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                <Button Classes="chip" Classes.active="{Binding FilterMounted}"
                        Content="已挂载" Command="{Binding SetFilterCommand}" CommandParameter="mounted" />
                <Button Classes="chip" Classes.active="{Binding FilterUnmounted}"
                        Content="未挂载" Command="{Binding SetFilterCommand}" CommandParameter="unmounted" />
            </StackPanel>
        </Grid>

        <!-- ===================== 挂载列表 ===================== -->
        <Border Grid.Row="2" Margin="20,0,20,18" Classes="card" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <!-- 表头 -->
                <Border Grid.Row="0" Padding="18,10"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="36,*,96,120">
                        <TextBlock Grid.Column="0" Text="状态" Classes="hint" />
                        <TextBlock Grid.Column="1" Text="名称" Classes="hint" />
                        <TextBlock Grid.Column="2" Text="挂载点" Classes="hint" />
                        <TextBlock Grid.Column="3" Text="操作" Classes="hint" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         Classes="mountList"
                         ItemsSource="{Binding VisibleMounts}"
                         SelectedItem="{Binding SelectedMount}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MountInfo">
                            <Grid ColumnDefinitions="36,*,96,120" Margin="12,9">
                                <!-- 状态灯 -->
                                <Panel Grid.Column="0" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" HorizontalAlignment="Left"
                                             Fill="{DynamicResource SuccessBrush}"
                                             IsVisible="{Binding IsMounted}" />
                                    <Ellipse Width="9" Height="9" HorizontalAlignment="Left"
                                             Fill="{DynamicResource WarningBrush}"
                                             IsVisible="{Binding IsMounting}" />
                                    <Ellipse Width="9" Height="9" HorizontalAlignment="Left"
                                             Fill="{DynamicResource ForegroundDisabledBrush}"
                                             IsVisible="{Binding CanMount}" />
                                </Panel>

                                <!-- 名称 + 类型徽标 + 状态 -->
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="badge">
                                            <TextBlock Text="{Binding TypeLabel}" Classes="badgeText" />
                                        </Border>
                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- 后台上传：rclone 写缓存模式下复制会立即返回，这里显示真实进度并可取消 -->
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding HasPendingUploads}">
                                        <TextBlock Text="{Binding PendingUploadText, StringFormat='后台上传中 {0}'}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource WarningBrush}" />
                                        <Button Classes="ghost" Padding="6,0" FontSize="11"
                                                Content="取消上传" Foreground="{DynamicResource WarningBrush}"
                                                Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).CancelUploadCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 挂载点 -->
                                <TextBlock Grid.Column="2" Text="{Binding LocalDrive}" FontSize="13"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundSecondaryBrush}" />

                                <!-- 操作 -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Classes="iconOnly" IsVisible="{Binding CanMount}"
                                            ToolTip.Tip="挂载"
                                            Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).MountItemCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Width="13" Height="13" Stretch="Uniform"
                                              Fill="{DynamicResource AccentBrush}"
                                              Data="{DynamicResource IconPlay}" />
                                    </Button>
                                    <Button Classes="iconOnly" IsVisible="{Binding IsMounting}"
                                            ToolTip.Tip="取消挂载"
                                            Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).CancelMountItemCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Fill="{DynamicResource ErrorBrush}"
                                              Data="{DynamicResource IconClose}" />
                                    </Button>
                                    <Button Classes="iconOnly" IsVisible="{Binding IsMounted}"
                                            ToolTip.Tip="卸载"
                                            Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).UnmountItemCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Width="13" Height="13" Stretch="Uniform"
                                              Fill="{DynamicResource ForegroundSecondaryBrush}"
                                              Data="{DynamicResource IconStop}" />
                                    </Button>
                                    <Button Classes="iconOnly"
                                            ToolTip.Tip="编辑（运行中进入只读查看）"
                                            Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).EditItemCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Width="13" Height="13" Stretch="Uniform"
                                              Fill="{DynamicResource ForegroundSecondaryBrush}"
                                              Data="{DynamicResource IconEdit}" />
                                    </Button>
                                    <Button Classes="iconOnly"
                                            ToolTip.Tip="删除"
                                            Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).DeleteItemCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Width="13" Height="13" Stretch="Uniform"
                                              Fill="{DynamicResource ForegroundSecondaryBrush}"
                                              Data="{DynamicResource IconDelete}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空状态 -->
                <StackPanel Grid.Row="1" IsVisible="{Binding IsListEmpty}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10" Margin="0,60,0,60" MaxWidth="360">
                    <Path Width="38" Height="38" Stretch="Uniform"
                          Fill="{DynamicResource ForegroundDisabledBrush}"
                          Data="{DynamicResource IconCloud}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                    <TextBlock Text="{Binding EmptyHint}" Classes="hint" TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 编辑 / 查看对话框 ===================== -->
        <Border Grid.Row="0" Grid.RowSpan="3" ZIndex="100"
                Background="{DynamicResource OverlayBrush}"
                IsVisible="{Binding IsEditing}">
            <Border Classes="dialog" Width="590" MaxHeight="680"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- 标题 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="{Binding DialogTitle}" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="{Binding DialogHint}" Classes="hint" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="iconOnly" VerticalAlignment="Top"
                                Command="{Binding CancelEditCommand}" ToolTip.Tip="关闭">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{DynamicResource ForegroundMutedBrush}"
                                  Data="{DynamicResource IconClose}" />
                        </Button>
                    </Grid>

                    <!-- 只读提示 -->
                    <Border Grid.Row="1" Classes="banner" Margin="0,14,0,0"
                            IsVisible="{Binding IsViewMode}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{DynamicResource AccentBrush}" Data="{DynamicResource IconLock}" />
                            <TextBlock Text="只读查看：该挂载正在运行。卸载后才能修改配置。"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 表单：向右延伸到底，让悬浮细滚动条贴住对话框边缘；内容自己留 20 的右边距 -->
                    <ScrollViewer Grid.Row="2" Margin="0,16,-20,0">
                        <StackPanel Spacing="16" Margin="0,0,20,0">

                            <!-- 基本 -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="基本" Classes="sectionTitle" />
                                <Grid ColumnDefinitions="110,*">
                                    <TextBlock Grid.Column="0" Text="名称" Classes="fieldLabel" />
                                    <TextBox Grid.Column="1" Text="{Binding EditingMount.Name}"
                                             IsReadOnly="{Binding IsViewMode}"
                                             PlaceholderText="例如：家庭网盘" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*">
                                    <TextBlock Grid.Column="0" Text="类型" Classes="fieldLabel" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              SelectedItem="{Binding EditingMount.Type}"
                                              IsEnabled="{Binding CanEdit}">
                                        <x:String>webdav</x:String>
                                        <x:String>ftp</x:String>
                                        <x:String>sftp</x:String>
                                        <x:String>s3</x:String>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <Border Classes="divider" />

                            <!-- 服务器 -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="服务器" Classes="sectionTitle" />

                                <!-- WebDAV：协议 + 主机 + 端口 -->
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsWebDavType}">
                                    <TextBlock Grid.Column="0" Text="主机地址" Classes="fieldLabel" />
                                    <Grid Grid.Column="1" ColumnDefinitions="96,*,Auto,72">
                                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                  SelectedItem="{Binding EditingMount.Protocol}"
                                                  ItemsSource="{Binding ProtocolOptions}"
                                                  IsEnabled="{Binding CanEdit}" />
                                        <TextBox Grid.Column="1" Text="{Binding EditingMount.Host}"
                                                 IsReadOnly="{Binding IsViewMode}"
                                                 PlaceholderText="example.com" Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="2" Text=":" VerticalAlignment="Center" Margin="4,0"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        <TextBox Grid.Column="3" Text="{Binding EditingMount.Port}"
                                                 IsReadOnly="{Binding IsViewMode}"
                                                 PlaceholderText="443" Margin="4,0,0,0" />
                                    </Grid>
                                </Grid>

                                <!-- FTP / SFTP：主机 + 端口 -->
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsFtpType}">
                                    <TextBlock Grid.Column="0" Text="主机地址" Classes="fieldLabel" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto,72">
                                        <TextBox Grid.Column="0" Text="{Binding EditingMount.Host}"
                                                 IsReadOnly="{Binding IsViewMode}"
                                                 PlaceholderText="ftp.example.com" />
                                        <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="6,0"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        <TextBox Grid.Column="2" Text="{Binding EditingMount.Port}"
                                                 IsReadOnly="{Binding IsViewMode}"
                                                 PlaceholderText="21" />
                                    </Grid>
                                </Grid>
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsSftpType}">
                                    <TextBlock Grid.Column="0" Text="主机地址" Classes="fieldLabel" />
                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto,72">
                                        <TextBox Grid.Column="0" Text="{Binding EditingMount.Host}"
                                                 IsReadOnly="{Binding IsViewMode}"
                                                 PlaceholderText="sftp.example.com" />
                                        <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="6,0"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                                        <TextBox Grid.Column="2" Text="{Binding EditingMount.Port}"
                                                 IsReadOnly="{Binding IsViewMode}"
                                                 PlaceholderText="22" />
                                    </Grid>
                                </Grid>

                                <!-- S3 -->
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsS3Type}">
                                    <TextBlock Grid.Column="0" Text="服务商" Classes="fieldLabel" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              SelectedItem="{Binding EditingMount.S3Provider}"
                                              IsEnabled="{Binding CanEdit}">
                                        <x:String>AWS</x:String>
                                        <x:String>Alibaba</x:String>
                                        <x:String>TencentCOS</x:String>
                                        <x:String>Google</x:String>
                                        <x:String>Other</x:String>
                                    </ComboBox>
                                </Grid>

                                <!-- 其他类型：完整 URL -->
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.UseUrlInput}">
                                    <TextBlock Grid.Column="0" Text="URL" Classes="fieldLabel" />
                                    <TextBox Grid.Column="1" Text="{Binding EditingMount.Url}"
                                             IsReadOnly="{Binding IsViewMode}"
                                             PlaceholderText="https://example.com/path" />
                                </Grid>

                                <!-- 路径（网络存储） -->
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsNetworkStorageType}">
                                    <TextBlock Grid.Column="0" Text="路径" Classes="fieldLabel" />
                                    <TextBox Grid.Column="1" Text="{Binding EditingMount.Path}"
                                             IsReadOnly="{Binding IsViewMode}"
                                             PlaceholderText="可选，例如 dav/files" />
                                </Grid>

                                <!-- 用户名 / 密码（网络存储） -->
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsNetworkStorageType}">
                                    <TextBlock Grid.Column="0" Text="用户名" Classes="fieldLabel" />
                                    <TextBox Grid.Column="1" Text="{Binding EditingMount.User}"
                                             IsReadOnly="{Binding IsViewMode}"
                                             PlaceholderText="可选" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsNetworkStorageType}">
                                    <TextBlock Grid.Column="0" Text="密码" Classes="fieldLabel" />
                                    <TextBox Grid.Column="1" Text="{Binding EditingMount.Password}"
                                             IsReadOnly="{Binding IsViewMode}"
                                             PasswordChar="*" PlaceholderText="可选" />
                                </Grid>

                                <!-- WebDAV 服务商 -->
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsWebDavType}">
                                    <TextBlock Grid.Column="0" Text="WebDAV 服务商" Classes="fieldLabel" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              SelectedItem="{Binding EditingMount.Vendor}"
                                              IsEnabled="{Binding CanEdit}">
                                        <x:String>other</x:String>
                                        <x:String>owncloud</x:String>
                                        <x:String>nextcloud</x:String>
                                        <x:String>sharepoint</x:String>
                                        <x:String>fastmail</x:String>
                                    </ComboBox>
                                </Grid>

                                <!-- S3 凭证 -->
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsS3Type}">
                                    <TextBlock Grid.Column="0" Text="Access Key" Classes="fieldLabel" />
                                    <TextBox Grid.Column="1" Text="{Binding EditingMount.AccessKeyId}"
                                             IsReadOnly="{Binding IsViewMode}"
                                             PlaceholderText="Access Key ID" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsS3Type}">
                                    <TextBlock Grid.Column="0" Text="Secret Key" Classes="fieldLabel" />
                                    <TextBox Grid.Column="1" Text="{Binding EditingMount.SecretAccessKey}"
                                             IsReadOnly="{Binding IsViewMode}"
                                             PasswordChar="*" PlaceholderText="Secret Access Key" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsS3Type}">
                                    <TextBlock Grid.Column="0" Text="区域" Classes="fieldLabel" />
                                    <TextBox Grid.Column="1" Text="{Binding EditingMount.Region}"
                                             IsReadOnly="{Binding IsViewMode}"
                                             PlaceholderText="可选，例如 us-east-1" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsS3Type}">
                                    <TextBlock Grid.Column="0" Text="Endpoint" Classes="fieldLabel" />
                                    <TextBox Grid.Column="1" Text="{Binding EditingMount.Endpoint}"
                                             IsReadOnly="{Binding IsViewMode}"
                                             PlaceholderText="可选，兼容 S3 的服务地址" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*" IsVisible="{Binding EditingMount.IsS3Type}">
                                    <TextBlock Grid.Column="0" Text="Bucket" Classes="fieldLabel" />
                                    <TextBox Grid.Column="1" Text="{Binding EditingMount.RemotePath}"
                                             IsReadOnly="{Binding IsViewMode}"
                                             PlaceholderText="bucket-name 或 bucket/path" />
                                </Grid>
                            </StackPanel>

                            <Border Classes="divider" />

                            <!-- 本地与选项 -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="本地与选项" Classes="sectionTitle" />
                                <Grid ColumnDefinitions="110,*">
                                    <TextBlock Grid.Column="0" Text="挂载点" Classes="fieldLabel" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding MountPointOptions}"
                                              SelectedItem="{Binding EditingMount.LocalDrive}"
                                              IsEnabled="{Binding CanEdit}" />
                                </Grid>
                                <CheckBox Content="网络驱动器模式（显示为「名称 (\\rclone)」）"
                                          IsChecked="{Binding EditingMount.UseNetworkMode}"
                                          IsEnabled="{Binding CanEdit}"
                                          Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                                <CheckBox Content="启动程序时自动挂载"
                                          IsChecked="{Binding EditingMount.AutoMountOnStart}"
                                          IsEnabled="{Binding CanEdit}"
                                          Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部操作 -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
                        <Button Grid.Column="0" Classes="secondary" Content="测试连接"
                                HorizontalAlignment="Left"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding !IsTestingConnection}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary" Content="卸载并编辑"
                                    IsVisible="{Binding IsViewMode}"
                                    Command="{Binding UnmountAndEditCommand}" />
                            <Button Classes="secondary" Content="取消"
                                    IsVisible="{Binding CanEdit}"
                                    Command="{Binding CancelEditCommand}" />
                            <Button Classes="primary" Content="{Binding SaveButtonText}"
                                    IsVisible="{Binding CanEdit}"
                                    Command="{Binding SaveMountCommand}" />
                            <Button Classes="secondary" Content="关闭"
                                    IsVisible="{Binding IsViewMode}"
                                    Command="{Binding CancelEditCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>