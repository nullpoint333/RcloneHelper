<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RcloneHelper.Core.Windows"
        xmlns:vmPages="using:RcloneHelper.Core.Pages"
        xmlns:pages="using:RcloneHelper.Views.Pages"
        xmlns:models="using:RcloneHelper.Core.Models"
        xmlns:converters="using:RcloneHelper.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="RcloneHelper.Views.Windows.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Rclone Helper"
        Width="1040" Height="720"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <converters:ToastTypeToBrushConverter x:Key="ToastTypeToBrushConverter" />
    </Window.Resources>

    <!-- ViewModel → View 映射 -->
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vmPages:HomePageViewModel}">
            <pages:HomePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmPages:RcloneConfigPageViewModel}">
            <pages:RcloneConfigPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmPages:SettingsPageViewModel}">
            <pages:SettingsPage />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <!-- 侧边导航 -->
        <Style Selector="Button.navButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondaryBrush}" />
            <Setter Property="Padding" Value="15,11" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.navButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavBarItemHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style Selector="Button.navButton.selected">
            <Setter Property="Background" Value="{DynamicResource NavBarItemSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.navButton.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavBarItemSelectedBrush}" />
        </Style>

        <!-- 标题栏按钮 -->
        <Style Selector="Button.titleBarButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.titleBarButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceLowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style Selector="Button.titleBarButton.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Toast -->
        <Style Selector="Border.toastItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BoxShadow" Value="0 6 18 0 #50000000" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="MaxWidth" Value="380" />
        </Style>
        <Style Selector="TextBlock.toastMessage">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="TextBlock.toastTime">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid ColumnDefinitions="212,*">
            <!-- 左侧导航栏 -->
            <Border Grid.Column="0" Background="{DynamicResource NavBarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="18,20,18,14" Spacing="10" Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSubtleBrush}">
                            <Path Width="19" Height="19" Stretch="Uniform"
                                  Fill="{DynamicResource AccentBrush}"
                                  Data="{DynamicResource IconCloud}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Rclone Helper" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource ForegroundBrush}" />
                                <TextBlock Text="{Binding AppVersion}" FontSize="10"
                                           Foreground="{DynamicResource ForegroundMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Text="网络存储挂载管理" FontSize="11"
                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 导航 -->
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <Button Classes="navButton" Classes.selected="{Binding IsHomeSelected}"
                                Command="{Binding NavigateHomeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Data="{DynamicResource IconHome}" />
                                <TextBlock Text="挂载管理" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="navButton" Classes.selected="{Binding IsRcloneSelected}"
                                Command="{Binding NavigateRcloneCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Data="{DynamicResource IconServer}" />
                                <TextBlock Text="Rclone 管理" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 设置固定在左下角 -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <Button Classes="navButton" Classes.selected="{Binding IsSettingsSelected}"
                                Command="{Binding NavigateSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Data="{DynamicResource IconSettings}" />
                                <TextBlock Text="设置" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧：标题栏 + 内容 -->
            <Grid Grid.Column="1" RowDefinitions="34,*">
                <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        PointerPressed="TitleBar_PointerPressed">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding PageTitle}" FontSize="12"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                   VerticalAlignment="Center" Margin="18,0,0,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Classes="titleBarButton" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="切换深色/浅色主题">
                                <Viewbox Width="14" Height="14">
                                    <Path x:Name="ThemeIcon" Fill="{DynamicResource TitleBarForegroundBrush}"
                                          Data="{DynamicResource IconSun}" />
                                </Viewbox>
                            </Button>
                            <Button Classes="titleBarButton" Click="MinimizeButton_Click" ToolTip.Tip="最小化">
                                <Viewbox Width="12" Height="12">
                                    <Path Fill="{DynamicResource TitleBarForegroundBrush}" Data="{DynamicResource IconMinimize}" />
                                </Viewbox>
                            </Button>
                            <Button Classes="titleBarButton" Click="MaximizeButton_Click" ToolTip.Tip="最大化/还原">
                                <Viewbox x:Name="MaximizeIcon" Width="12" Height="12">
                                    <Path Fill="{DynamicResource TitleBarForegroundBrush}" Data="{DynamicResource IconMaximize}" />
                                </Viewbox>
                            </Button>
                            <Button Classes="titleBarButton close" Click="CloseButton_Click" ToolTip.Tip="关闭到托盘">
                                <Viewbox Width="10" Height="10">
                                    <Path Fill="{DynamicResource TitleBarForegroundBrush}" Data="{DynamicResource IconClose}" />
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区 -->
                <Border Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}">
                    <Grid>
                        <ContentControl Content="{Binding CurrentPage}" />

                        <!-- Toast 容器 -->
                        <ItemsControl ItemsSource="{Binding Toasts}"
                                      VerticalAlignment="Bottom"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,24,24"
                                      ZIndex="1000">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ToastItem">
                                    <Border Classes="toastItem"
                                            Background="{Binding Type, Converter={StaticResource ToastTypeToBrushConverter}}"
                                            IsVisible="{Binding IsVisible}"
                                            Opacity="{Binding Opacity}"
                                            ClipToBounds="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="{Binding OffsetY}" />
                                        </Border.RenderTransform>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Message}" Classes="toastMessage" />
                                            <TextBlock Text="{Binding Time}" Classes="toastTime" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 确认对话框覆盖层 -->
        <Border x:Name="DialogOverlay"
                IsVisible="False"
                ZIndex="2000"
                Background="{DynamicResource OverlayBrush}">
            <Border Classes="dialog" MaxWidth="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="请确认" Classes="cardTitle" Margin="0,0,0,10" />
                    <TextBlock x:Name="DialogMessage"
                               Grid.Row="1"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundSecondaryBrush}" />
                    <Grid Grid.Row="2" Margin="0,20,0,0" ColumnDefinitions="*,*">
                        <Button x:Name="DialogConfirmButton"
                                Grid.Column="0"
                                Content="确认"
                                Classes="primary"
                                HorizontalAlignment="Stretch" />
                        <Button x:Name="DialogCancelButton"
                                Grid.Column="1"
                                Content="取消"
                                Classes="secondary"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>